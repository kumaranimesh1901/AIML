# Database connection (PostgreSQL 16 + pgvector by default, SQLite for local dev/tests)
EDG_DATABASE_URL=postgresql+psycopg://edg:edg@localhost:5432/edg

# LLM provider endpoints
EDG_OLLAMA_BASE_URL=http://localhost:11434
EDG_OPENAI_BASE_URL=http://localhost:8000/v1
EDG_OPENAI_API_KEY=not-needed-for-local

# Logging
EDG_LOG_LEVEL=INFO
EDG_LOG_FORMAT=json
